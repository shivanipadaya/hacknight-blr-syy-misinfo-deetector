# Elastic Cloud: use either ELASTIC_CLOUD_ID or ELASTICSEARCH_URL.
# The Kibana URL is not enough; copy the Elasticsearch endpoint from Elastic Cloud.
ELASTIC_CLOUD_ID=
ELASTICSEARCH_URL=
ELASTICSEARCH_API_KEY=
ELASTICSEARCH_USERNAME=
ELASTICSEARCH_PASSWORD=

ELASTICSEARCH_INDEX=blr_claim_sources_v1
ELSER_INFERENCE_ID=.elser-2-elasticsearch

# Use "sparse_vector" for newer Elastic inference endpoints.
# Use "text_expansion" if your deployment/examples are built around .elser_model_2 directly.
ELSER_QUERY_MODE=sparse_vector

# Runtime uses Elastic only. Create these inference endpoints in Elastic,
# or provide provider keys only during setup if you want src.create_index to create them.
JINA_RERANK_INFERENCE_ID=jina-reranker-v3
RERANK_ENABLED=true
LLM_INFERENCE_ID=.gp-llm-v2-chat_completion
LLM_TASK_TYPE=chat_completion
LLM_MAX_TOKENS=900

# Do not add Jina/Anthropic keys here when the endpoints are already configured in
# Elastic Inference Service:
# https://new-1804f1.kb.us-east-1.aws.found.io/app/management/modelManagement/elastic_inference_service

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
